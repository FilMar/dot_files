input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
    }

    mouse {
         //natural-scroll
    }

}

environment {
    // Forza il tema scuro per le app GTK4/Libadwaita
    "GTK_THEME" "Adwaita-dark" 
    
    // Indica alle app di preferire lo schema scuro tramite XDG Desktop Portal
    "XDG_CURRENT_DESKTOP" "niri"
    
    // Per le app Qt (come Telegram Desktop)
    "QT_QPA_PLATFORM" "wayland"
    "QT_QPA_PLATFORMTHEME" "qt6ct" // O "gnome" se preferisci
}

output "eDP-1" {
    mode "1920x1080@60"
    scale 1
    transform "normal"
}

output "DP-2" {
    mode "1920x1080@60"
    scale 1
    transform "normal"
}

layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#f9e2af"
        inactive-color "#89b4fa"
    }

    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

spawn-at-startup "noctalia"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
hotkey-overlay {
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
animations {
}

// Noctalia: rounded corners for a modern look.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Noctalia: floating settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match title="^launcher$"
    open-floating true
    default-column-width { fixed 1200; }
}

// Noctalia: allow notification actions and window activation.
debug {
    honor-xdg-activation-with-invalid-serial
}

// Noctalia: blurred overview wallpaper backdrop.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// Noctalia: blur behind windows and surfaces.
window-rule {
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

binds {
    Alt+Return hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty"; }

    // Noctalia core binds
    //Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    //Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    //Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    //Alt+Tab { spawn-sh "noctalia msg window-switcher"; }

    // Audio & Brightness (Noctalia OSD)
    XF86AudioRaiseVolume  { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute      { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    Alt+P { spawn-sh "foot --title=launcher -e $HOME/git_projects/dot_files/scripts/launcher.py apps"; }
    Alt+C { spawn-sh "foot --title=launcher -e $HOME/git_projects/dot_files/scripts/launcher.py clipboard"; }

    Alt+Q repeat=false { close-window; }
    Alt+Shift+Q { quit; }

    Alt+H    { focus-column-left; }
    Alt+K    { focus-workspace-up; }
    Alt+J    { focus-workspace-down; }
    Alt+L     { focus-column-right; }
    Alt+Shift+H     { move-column-left; }
    //Alt+Shift+K    { move-workspace-up; }
    //Alt+Shift+J    { move-workspace-down; }
    Alt+Shift+L     { move-column-right; }
    Alt+F { maximize-column; }
    Alt+V       { toggle-window-floating; }

    Alt+S { screenshot; }
    Alt+Shift+S { screenshot-screen; }
    Alt+Ctrl+S { screenshot-window; }
}
